# GPU inference image for Nosana: Ollama serving both the chat model and the embedding model
# through its OpenAI-compatible API (/v1/chat/completions, /v1/embeddings). Contains model
# weights and the inference server only -- no application code, no DB credentials, no API keys.
FROM ollama/ollama:latest

ENV CHAT_MODEL=llama3.1
ENV EMBEDDING_MODEL=nomic-embed-text

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 11434
ENTRYPOINT ["/entrypoint.sh"]
